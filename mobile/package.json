{
  "name": "merchnow-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start --port 8081",
    "build:android": "npx expo export -p android --output-dir ../dist/mobile",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app/ --fix",
    "test": "vitest --run",
    "eject": "expo eject"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~2.1.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~52.0.0",
    "expo-camera": "~15.0.0",
    "expo-file-system": "~18.0.0",
    "expo-image-picker": "~16.0.0",
    "expo-keep-awake": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-location": "~17.0.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.28.0",
    "expo-status-bar": "~2.0.0",
    "query-string": "^9.5.1",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.14.0",
    "react-native-screens": "~4.0.0"
  },
  "devDependencies": {
    "@react-native-community/netinfo": "11.0.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "expo": {
    "name": "MerchNow",
    "slug": "merchnow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "merchnow",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#8B5CF6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.merchnow.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8B5CF6"
      },
      "package": "ai.merchnow.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundled": true
    }
  }
}
